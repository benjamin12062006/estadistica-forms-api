# Descope Project ID usado también como audiencia predeterminada del session JWT.
DESCOPE_PROJECT_ID=your-descope-project-id

# Solo para el script local de pruebas E2E. Nunca se exponen al frontend.
DESCOPE_MANAGEMENT_KEY=your-descope-management-key
DESCOPE_TEST_LOGIN_ID=auth-test@example.test

# Desarrollo diario: SQLite local administrado por Prisma Migrate.
DATABASE_URL=file:./.data/estadistica-dev.db

# Compatibilidad histórica para una futura conexión remota; no forma parte
# del flujo local de migraciones de esta etapa.
# DATABASE_URL=libsql://your-database-your-organization.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
# TURSO_DATABASE_URL=libsql://your-database-your-organization.turso.io
